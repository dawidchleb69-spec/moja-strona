<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>moja pierwsza strona</title>
    <style>
        
        body {
            background-color: #ffffff;
            color: #000000;
            font-family: Arial, sans-serif;
            margin: 30px auto;
            max-width: 800px;
        }

        
        .kontener-makiety {
            background-color: #bcbcbc;
            border: 1px solid #000000;
            padding: 10px;
        }

        
        .logo {
            background-color: #e1e1e1;
            border: 1px solid #000000;
            text-align: center;
            padding: 12px;
            margin-bottom: 6px;
            font-size: 18px;
            font-weight: bold;
        }

        
        .pasek-linkow {
            background-color: #e1e1e1;
            border: 1px solid #000000;
            text-align: center;
            padding: 6px;
            margin-bottom: 6px;
            font-size: 14px;
        }
        .pasek-linkow a {
            color: #000000;
            text-decoration: none;
            margin: 0 15px;
        }

        
        .sekcja-srodkowa {
            overflow: hidden; /* Wyczyszczenie opływu (float) */
            margin-bottom: 6px;
        }

        
        .tresc-strony {
            background-color: #9c9c9c;
            border: 1px solid #000000;
            width: 65%;
            float: left;
            padding: 15px;
            min-height: 280px;
            box-sizing: border-box;
        }

        
        .foto-auta {
            width: 100%;
            height: auto;
            border: 1px solid #000000;
            margin-top: 10px;
            display: block;
        }

        
        .prawa-kolumna {
            width: 33%;
            float: right;
            box-sizing: border-box;
        }

        
        .kafelek-link {
            background-color: #e1e1e1;
            border: 1px solid #000000;
            text-align: center;
            padding: 15px;
            margin-bottom: 6px;
            font-size: 14px;
        }
        .kafelek-link:last-child {
            margin-bottom: 0; 
        }
        .kafelek-link a {
            color: #000000;
            text-decoration: none;
            display: block;
        }

        
        .stopka {
            background-color: #e1e1e1;
            border: 1px solid #000000;
            text-align: center;
            padding: 10px;
            font-size: 14px;
        }
    </style>
</head>
<body>

    
    <div class="kontener-makiety">

        
        <div class="logo">
             Józef Piłsudski
        </div>

        
        <div class="pasek-linkow">
            <a href="#">Marszałek państwa</a>
            
            
            
        </div>

        
        <div class="sekcja-srodkowa">
            
            
            <div class="tresc-strony">
                <strong>treść strony:</strong>
                <p>Był I Marszałkiem Polski, Generalnym Inspektoerm Sił Zbrojnych, Przedodniczący Ścisłej Rady Wojennej.</p>
                
                
                <img src="zdjęcie.jpg/images.jpg" width="75%">
            </div>

            
            <div class="prawa-kolumna">
                <div class="kafelek-link"><a href="#">I wojna światowa</a></div>
                <div class="kafelek-link"><a href="#">Wojna Polsko-Bolszewicka</a></div>
                <div class="kafelek-link"><a href="#">Bitwa Warszawska</a></div>
                <div class="kafelek-link"><a href="#">Wyprawa kijowska</a></div>
            </div>

        </div>

        
        <div class="stopka">
            stopka
        </div>

    </div>

</body>
</html>
